{
  "name": "monfolio",
  "version": "0.1.0",
  "private": true,
  "description": "MonFolio — Community Monad Portfolio Dashboard. Not affiliated with Monad Foundation.",
  "scripts": {
    "dev": "next dev",
    "dev:fresh": "npm run clean && next dev",
