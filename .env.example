# Onchain Pulse - Environment Variables
# Copy this to .env.local and fill in your values.

# Canonical production URL used for Open Graph metadata.
NEXT_PUBLIC_SITE_URL=https://onchainpulse.app

# RPC endpoints
# Server-only RPC for portfolio and API route reads. Use this for keyed RPC URLs.
MONAD_RPC_URL=https://rpc.example.com/YOUR_KEY

# Public fallback for client-side chain metadata only. Do not put private keys here.
NEXT_PUBLIC_MONAD_RPC_URL=https://rpc.monad.xyz

# Optional: BlockVision API for transaction history.
# Sign up at https://blockvision.org
# BLOCKVISION_API_KEY=

# Optional: DeBank Cloud API for enriched portfolio data.
# Sign up at https://cloud.debank.com
# DEBANK_API_KEY=
