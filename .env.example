# Onchain Pulse - Environment Variables
# Copy this to .env.local and fill in your values.

# Canonical production URL used for Open Graph metadata.
NEXT_PUBLIC_SITE_URL=https://onchainpulse.app

# Google Analytics 4 measurement ID. Example: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Private access gate session signing secret.
# Set this to a long random string in Vercel.
ACCESS_GATE_SECRET=
# Comma or newline separated one-time invite codes. Keep private in Vercel.
ACCESS_CODES=

# RPC endpoints
# Server-only RPC for portfolio and API route reads. Use this for keyed RPC URLs.
MONAD_RPC_URL=https://rpc.example.com/YOUR_KEY

# Public fallback for client-side chain metadata only. Do not put private keys here.
NEXT_PUBLIC_MONAD_RPC_URL=https://rpc.monad.xyz

# Optional: BlockVision API for transaction history.
# Sign up at https://blockvision.org
# BLOCKVISION_API_KEY=

# Optional: OpenSea API for Monad NFT market data.
# OPENSEA_API_KEY=

# Curated news admin.
# NEWS_INGEST_TOKEN protects direct/scripted submissions.
# NEWS_ADMIN_PASSWORD protects /news/admin with browser Basic Auth.
# The admin page creates a secure session, so you do not need to paste this token there.
# If NEWS_ADMIN_PASSWORD is omitted, NEWS_INGEST_TOKEN is used for both.
# NEWS_ADMIN_USERNAME defaults to OPbolte when omitted.
# NEWS_INGEST_TOKEN=
# NEWS_ADMIN_USERNAME=OPbolte
# NEWS_ADMIN_PASSWORD=

# Telegram bot private alerts and public channel broadcasts.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_CHANNEL_ID=@your_channel_username
# TELEGRAM_CHANNEL_USERNAME=your_channel_username
# NEXT_PUBLIC_TELEGRAM_CHANNEL_URL=https://t.me/your_channel_username

# Optional: DeBank Cloud API for enriched portfolio data.
# Sign up at https://cloud.debank.com
# DEBANK_API_KEY=
