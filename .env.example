# MonFolio — Environment Variables
# Copy this to .env.local and fill in your values

# ─── RPC Endpoints ───
# Public (rate-limited, fine for dev):
NEXT_PUBLIC_MONAD_RPC_URL=https://monad-mainnet.drpc.org

# For production, get a paid key from Alchemy/QuickNode/Chainstack:
# NEXT_PUBLIC_MONAD_RPC_URL=https://monad-mainnet.g.alchemy.com/v2/YOUR_KEY

# ─── Optional: BlockVision API (for transaction history) ───
# Sign up at https://blockvision.org
# BLOCKVISION_API_KEY=

# ─── Optional: DeBank Cloud API (for enriched portfolio data) ───
# Sign up at https://cloud.debank.com
# DEBANK_API_KEY=
